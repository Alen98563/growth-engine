# Hyperliquid Growth Mode Market-Making Engine
# ==========================================
# Copy this file to .env and fill in your values.
# WARNING: .env contains secrets — NEVER commit .env to version control.
#
# Required: HL_PRIVATE_KEY
# All other variables have sensible defaults for FARTCOIN/PUMP Growth Mode.

# ── API Endpoints ──
# HL mainnet REST API
HL_API_URL=https://api.hyperliquid.xyz
# HL mainnet WebSocket stream
HL_WS_URL=wss://api.hyperliquid.xyz/ws

# ── Wallet ──
# EOA wallet address (0x-prefixed)
HL_ADDRESS=0xYOUR_ADDRESS_HERE
# Private key (hex, 64 chars, with or without 0x prefix)
# WARNING: This is your wallet's private key. Guard it with your life.
HL_PRIVATE_KEY=0x_your_private_key_here

# ── Market-Making Coins ──
# Comma-separated list of coin tickers to market-make
# Only coins with HIP-3 Growth Mode (feeScale=0.1111, hyna deployer) are supported
HL_COINS=PUMP,FARTCOIN

# ── Growth Mode ──
# Set to true for HIP-3 Growth Mode (maker=0.17bps, taker=0.50bps)
# Set to false for Standard trading (maker=1.5bps, taker=4.5bps)
HL_GROWTH_MODE=true

# ── Pricing ──
# Cubic skew exponent (3.0 = cubic, 2.0 = quadratic)
# Higher powers preserve more spread at moderate positions
# HL_SKEW_POWER=3.0
# Maximum skew in basis points at 100% position
# HL_MAX_SKEW_BPS=2.0

# ── Tick Sizes ──
# Default tick size (used when per-coin not specified)
HL_TICK_SIZE=0.000001
# Per-coin tick sizes: COIN=TICK,COIN=TICK
# PUMP: 0.000001, FARTCOIN: 0.00001
# HL_TICK_SIZES=PUMP=0.000001,FARTCOIN=0.00001

# ── Order Sizing ──
# Minimum order size in native units (below this = zeroed out)
HL_MIN_ORDER_SIZE=1.0
# Base order size in USD notional per quote
HL_BASE_ORDER_NOTIONAL=10.0

# ── Risk Controls ──
# Passive unwind watermark (fraction of hard_limit, e.g. 0.40)
# Triggers when position_ratio >= this value
HL_PASSIVE_UNWIND_WATERMARK=0.40
# Hysteresis buffer: exit UNWIND at watermark − hysteresis
# Prevents state flickering near the watermark
HL_UNWIND_HYSTERESIS=0.20
# Minimum profitable net spread in bps (below this = freeze orders)
HL_MIN_PROFITABLE_SPREAD_BPS=1.5
# Freeze BUY orders when position_ratio exceeds this in NORMAL state
HL_BUY_DISABLE_RATIO=0.20
# GTC last-resort discount: sell at best_bid × this when IOC fails 3+ rounds
# HL_LAST_RESORT_GAMBLE_DISCOUNT=0.95
# Max consecutive cooldowns before forced IOC shed
# HL_MAX_CONSECUTIVE_COOLDOWNS=3

# ── Kill Switch ──
# Minimum withdrawable balance (USD) before emergency kill switch triggers
# HL_KILLSWITCH_MIN_WD=80.0

# ── Anti-Ping-Pong ──
# Post-unwind cooldown in seconds (suppress BUY orders after exiting UNWIND)
# HL_POST_UNWIND_COOLDOWN_SECS=60.0
# Bid spread multiplier during post-unwind cooldown
# HL_POST_UNWIND_BID_SPREAD_MULT=3.0

# ── Volatility-Adaptive ──
# Number of past mid-price samples for volatility estimation
# HL_VOL_LOOKBACK_CYCLES=6
# Volatility multiplier cap
# HL_VOL_MULTIPLIER_CAP=3.0
# Volatility threshold in bps (above this, multiplier activates)
# HL_VOL_THRESHOLD_BPS=5.0

# ── Circuit Breaker ──
# Sliding window for API failure detection (seconds)
# HL_CIRCUIT_BREAKER_WINDOW_SECS=5.0
# Number of API failures to trip the breaker
# HL_CIRCUIT_BREAKER_MAX_FAILURES=3

# ── Dynamic Position Cap ──
# Base hard-limit ratio in quiet markets
# HL_DYNAMIC_HARD_LIMIT_BASE=0.40
# Floor hard-limit ratio during extreme volatility
# HL_DYNAMIC_HARD_LIMIT_MIN=0.15

# ── Liquidation Defense ──
# Fractional distance from mark to liquidation below which emergency exit triggers
# E.g. 0.08 = 8% distance triggers kill switch
# HL_LIQUIDATION_DISTANCE_THRESHOLD=0.08

# ── Dust Filter ──
# Positions with notional below this (USD) excluded from risk calculations
# HL_DUST_THRESHOLD_NOTIONAL=20.0

# ── Multi-Level Quoting ──
# Number of price levels per side (1 = single quote, 3+ = multi-level grid)
# HL_NUM_LEVELS=3
# Sigma multipliers for each level (comma-separated)
# Level 0 = nearest to mid, Level N-1 = farthest
# HL_LEVEL_SIGMAS=0.8,1.8,3.0

# ── Logging ──
# Log level filter (error, warn, info, debug, trace)
# Structured JSON logs to stdout
RUST_LOG=growth_engine=info
